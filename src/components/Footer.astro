---
import { BUILT_WITH, SITE, SOCIALS } from '../site';
import { href, urls } from '../lib/urls';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Project',
    links: [
      { label: 'Report an issue', url: SITE.issues, external: true },
      { label: 'Contributing', url: SITE.contributing, external: true },
    ],
  },
  {
    title: 'Explore',
    links: [
      { label: 'How ranks work', url: urls.rank(), external: false },
      { label: 'How embedding works', url: href('#how'), external: false },
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-grid">
    <!-- The logo gets its own row, so the link columns line up with the description under it. -->
    <div class="footer-logo">
      <Logo height={64} />
    </div>
    <div class="footer-brand">
      <p class="caption">
        {SITE.tagline} Free and open source under the {SITE.license.name} License. Fork it, self-host it, send a PR.
      </p>
      <!-- On hover, "Star" glitches into a star. Both share one grid cell so the button keeps its width. -->
      <a class="btn btn-ghost footer-star" href={SITE.repo} rel="noopener" aria-label="Star on GitHub">
        <span class="star-swap" aria-hidden="true">
          <span class="star-word">Star</span>
          <svg class="star-icon" width="16" height="16" viewBox="0 0 24 24" focusable="false">
            <path fill="currentColor" d="M12 1.8l3 7 7.6.6-5.8 5 1.8 7.4L12 17.8l-6.6 4 1.8-7.4-5.8-5 7.6-.6z" />
          </svg>
        </span>
        <span aria-hidden="true">on GitHub</span>
      </a>
    </div>

    {columns.map((col) => (
      <nav class="footer-col" aria-label={col.title}>
        <p class="eyebrow">{col.title}</p>
        <ul>
          {col.links.map((link) => (
            <li>
              <a href={link.url} rel={link.external ? 'noopener' : undefined}>
                {link.label}
                {link.external && (
                  <span class="ext" aria-hidden="true">
                    ↗
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}

    <nav class="footer-col footer-built" aria-label="Built with">
      <p class="eyebrow">Built with</p>
      <ul class="socials built-with">
        {BUILT_WITH.map((b) => (
          <li>
            <a href={b.url} rel="noopener" aria-label={b.label} title={b.label}>
              <Icon name={b.icon} />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="footer-bar">
    <!-- No punctuation right after a link: formatter line breaks would turn into stray spaces. -->
    <p class="caption footer-copy">
      <span>© {year}</span>
      <a href={SITE.author.url} rel="noopener">
        {SITE.author.name}
      </a>
      <span aria-hidden="true">//</span>
      <a href={SITE.license.url} rel="noopener">
        {SITE.license.name} License
      </a>
    </p>
    <ul class="socials" aria-label="Elsewhere">
      {SOCIALS.map((s) => (
        <li>
          <a href={s.url} rel={['noopener', s.rel].filter(Boolean).join(' ')} aria-label={s.label} title={s.label}>
            <Icon name={s.icon} />
          </a>
        </li>
      ))}
    </ul>
    <p class="caption footer-note">Public GitHub data only. Not affiliated with GitHub.</p>
  </div>
</footer>

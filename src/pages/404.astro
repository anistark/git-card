---
import ErrorState from '../components/ErrorState.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Not found · git-card" description="This page does not exist." noindex>
  <ErrorState status={404} message="There is nothing at this address." />
  <script>
    import { urls } from '../lib/urls';

    // Old server-rendered links looked like /u/<login> and /u/<login>/<card>. Send them to the new pages.
    const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
    const path = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname.replace(/^\//, '');
    const match = path.match(/^u\/([A-Za-z0-9-]{1,39})(?:\/([a-z-]+))?\/?$/);
    if (match) location.replace(match[2] ? urls.card(match[1], match[2]) : urls.profile(match[1]));
  </script>
</Base>
